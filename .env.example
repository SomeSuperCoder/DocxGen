# ---------- Сервер ----------
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
# Audio STT service (requires vosk package, ffmpeg and the Russian model)
AUDIO_SERVICE_PORT=3005
VOSK_MODEL_PATH=./models/vosk-model-small-ru-0.22
FFMPEG_BIN=ffmpeg
# Пусто — Python из .venv-audio для текущей ОС (создаёт npm run setup:audio в packages/backend)
VOSK_PYTHON=
# info — штатная работа; debug — входящие события ботов, переходы диалога, задачи очереди и тайминги ИИ
# Копия лога в JSON-строках — DATA_DIR/logs/app.log
LOG_LEVEL=info
# /ai_fail — имитация сбоя ИИ (сценарий 6). На публичном сервере можно выключить
DEBUG_COMMANDS=1

# ---------- ИИ ----------
# opencode — OpenCode CLI (бесплатные модели OpenCode Zen, ключ не нужен)
# openai — официальный OpenAI SDK (Responses API)
# mock — заглушка без ИИ (текст не исправляется), для тестов и проверки пути до DOCX
AI_PROVIDER=opencode
AI_TIMEOUT_MS=180000
AI_FAULT=off

# Запуск OpenCode: local — opencode из PATH (npm i -g opencode-ai); docker/podman — образ из pnpm opencode:build
OPENCODE_RUNTIME=local
OPENCODE_BIN=opencode
OPENCODE_IMAGE=doc3steps-opencode
# Пусто — модель из агента packages/backend/opencode/.opencode/agents/doc-editor.md (opencode/mimo-v2.5-free)
OPENCODE_MODEL=
OPENCODE_AGENT=doc-editor
# Бесплатные модели не держат параллельные запросы с одного адреса: второй зависает до таймаута
OPENCODE_MAX_PARALLEL=1

# Только для AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o

# ---------- MAX ----------
MAX_ENABLED=0
MAX_TOKEN=
MAX_API_URL=https://platform-api2.max.ru
# polling — локально, без домена; webhook — на сервере с HTTPS (нужен MAX_WEBHOOK_SECRET)
MAX_MODE=polling
MAX_WEBHOOK_SECRET=
# API MAX работает на сертификате УЦ Минцифры, которого нет в Node.js и Windows (источник — gosuslugi.ru/crt)
MAX_CA_FILE=certs/russian_trusted_root_ca.pem

# ---------- ВК ----------
VK_ENABLED=0
VK_GROUP_ID=
VK_TOKEN=
VK_API_VERSION=5.199
# longpoll — локально, без домена; callback — на сервере с HTTPS
VK_MODE=longpoll
VK_CALLBACK_SECRET=
VK_CONFIRMATION_CODE=

# ---------- Очистка ----------
CLEANUP_ENABLED=1
CLEANUP_INTERVAL_MS=3600000
CLEANUP_FILE_MAX_AGE_HOURS=24
CLEANUP_LOG_MAX_AGE_DAYS=30

# ---------- Ключ для внешних интеграций ----------
# Нужен только внешним HTTP-интеграциям, которые передают
# X-Owner-Platform / X-Owner-Id. Встроенные MAX/VK-адаптеры работают напрямую
# внутри единого backend и этот ключ для них не нужен.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=
